{
  "name": "glide",
  "version": "0.4.2",
  "private": true,
  "description": "A keyboard-first macOS launcher with a Shortcuts-style workflow builder, automations, an AI agent and vim keys.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobibytes/glide.git"
  },
  "homepage": "https://github.com/tobibytes/glide#readme",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "build:helper": "node scripts/build-helper.mjs",
    "build:main": "node scripts/build-main.mjs && node scripts/build-fileindex-worker.mjs && node scripts/glide-mcp.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:helper && pnpm build:main && pnpm build:renderer",
    "dev": "node scripts/dev.mjs",
    "start": "pnpm build && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "pnpm build && node scripts/e2e.mjs",
    "package": "pnpm build && node scripts/package.mjs",
    "install:app": "pnpm build && node scripts/package.mjs --install",
    "release": "pnpm build && node scripts/package.mjs --zip",
    "notarize": "node scripts/notarize.mjs --zip",
    "build:helper:universal": "node scripts/build-helper.mjs --arch universal",
    "release:universal": "pnpm build && node scripts/package.mjs --arch universal --zip",
    "test:harness": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e:smoke": "node tests/e2e/smoke.mjs",
    "test:visual": "node scripts/visual-snapshots.mjs",
    "test:visual:update": "node scripts/visual-snapshots.mjs --update",
    "test:a11y": "node scripts/a11y-audit.mjs",
    "test:perf": "node scripts/perf-search.mjs",
    "test:quality": "pnpm test:harness && pnpm test:e2e:smoke && pnpm test:perf && pnpm test:a11y",
    "test:e2e:onboarding": "node tests/e2e/onboarding.mjs",
    "dmg": "pnpm build && node scripts/package.mjs --arch universal --dmg",
    "test:e2e:mcp": "node src/main/features/mcp-server/e2e/mcp-e2e.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "productName": "Glide"
}
